# ==============================================================================
# AetherGuard (Breathe Better) - Environment Configuration
# ==============================================================================
# NOTE: The platform is engineered with a 100% ZERO-KEY, OUT-OF-THE-BOX baseline.
# If no keys are provided, the platform automatically uses Open-Meteo Air Quality,
# Weather Forecast, and Geocoding APIs seamlessly without any authentication required.
# ==============================================================================

# Tier 1: Keyless Baseline (Open-Meteo) - Defaults provided, no key required
VITE_OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
VITE_OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
VITE_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Tier 2: Physical Ground Station Telemetry (Optional)
# Get free WAQI token from: https://aqicn.org/data-platform/token/
VITE_WAQI_API_TOKEN=
# Get free OpenAQ v3 key from: https://openaq.org/
VITE_OPENAQ_API_KEY=

# Tier 3: Redundancy & Cross-Verification (Optional)
# Get free OpenWeatherMap API key from: https://openweathermap.org/api
VITE_OWM_API_KEY=

# Optional AI Assistant Key for conversational insights (Falls back to local deterministic model)
VITE_GEMINI_API_KEY=
